# =============================================================================
#  Inception — non-secret configuration
# -----------------------------------------------------------------------------
#  Copy this file to `srcs/.env` (`make setup` does it for you) and adjust
#  DATA_PATH to match the machine you are running on.
#  NO PASSWORD BELONGS IN THIS FILE — passwords live in ../secrets/*.txt and are
#  injected into the containers as Docker secrets.
# =============================================================================

# --- Identity -----------------------------------------------------------------
LOGIN=sarherna
DOMAIN_NAME=sarherna.42.fr

# --- Host storage -------------------------------------------------------------
# Absolute path ON THE HOST backing the two named volumes.
#   42 VM (Debian/Linux) -> /home/sarherna/data      <- required by the subject
#   local macOS + colima -> /Users/<youruser>/data   <- macOS has no writable /home
DATA_PATH=/home/sarherna/data

# --- Base image ---------------------------------------------------------------
# Penultimate stable Alpine branch (current stable is 3.24, so we pin 3.23).
ALPINE_VERSION=3.23

# --- MariaDB ------------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# --- WordPress ----------------------------------------------------------------
WP_TITLE=Inception
WP_URL=https://sarherna.42.fr

# The administrator login MUST NOT contain admin/Admin/administrator/Administrator
WP_ADMIN_USER=sarait
WP_ADMIN_EMAIL=sarherna@student.42.fr

# Second, non-administrator user
WP_USER=redactora
WP_USER_EMAIL=redactora@student.42.fr
WP_USER_ROLE=author
