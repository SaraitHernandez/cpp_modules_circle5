# -----------------------------------------------------------------------------
#  Rendered at container start: __DOMAIN_NAME__ is replaced by $DOMAIN_NAME.
# -----------------------------------------------------------------------------
user                 nginx;
worker_processes     auto;
pid                  /run/nginx/nginx.pid;
error_log            /dev/stderr warn;

events {
    worker_connections  1024;
}

http {
    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    access_log          /dev/stdout;

    sendfile            on;
    tcp_nopush          on;
    keepalive_timeout   65;
    server_tokens       off;
    client_max_body_size 32m;

    # -------------------------------------------------------------------------
    #  The one and only server: HTTPS, port 443. There is no :80 listener, so
    #  the infrastructure simply cannot be reached in clear text.
    # -------------------------------------------------------------------------
    server {
        listen              443 ssl;
        listen              [::]:443 ssl;
        http2               on;

        server_name         __DOMAIN_NAME__;

        ssl_certificate     /etc/nginx/ssl/inception.crt;
        ssl_certificate_key /etc/nginx/ssl/inception.key;

        # Required by the subject: TLSv1.2 / TLSv1.3 and nothing else.
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        root                /var/www/html;
        index               index.php index.html;

        location / {
            try_files $uri $uri/ /index.php?$args;
        }

        location ~ \.php$ {
            # Refuse to hand anything but a real file to php-fpm.
            try_files $uri =404;

            include      fastcgi.conf;
            fastcgi_pass wordpress:9000;
            fastcgi_index index.php;

            # Let WordPress know the original scheme was HTTPS.
            fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
            fastcgi_read_timeout 60s;
        }

        # Never serve the config file or the usual dotfile leftovers.
        location = /wp-config.php { deny all; }
        location ~ /\.          { deny all; }

        location ~* \.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$ {
            expires 7d;
            access_log off;
        }
    }
}
